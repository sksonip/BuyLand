@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Intravilan Land</title>
    <link rel="stylesheet" href="~/css/Style.css" asp-append-version="true">
</head>
<body>
    <div class="container">
        <!-- Search Bar -->
        <input type="text" id="searchBar" placeholder="Search for land..." onkeyup="filterItems()">

        <div class="sellerCards">
            <div class="card">
                <img src="/images/NoImageAvailable.jpg" alt="NoImage">
                <div class="container">
                    <h4><b>Teren la Sarbatoarea</b></h4>
                    <p>15 euro/metru</p>
                    <button onclick="addToCart('Teren in Craiova', 300)">Buy</button>
                </div>
            </div>

            <div class="card">
                <img src="/images/NoImageAvailable.jpg" alt="Land Image">
                <div class="container">
                    <h4><b>Teren in Bucovat</b></h4>
                    <p>10 euro/metru</p>
                    <button onclick="addToCart('Teren in Romanesti', 400)">Buy</button>
                </div>
            </div>

            <div class="card">
                <img src="/images/NoImageAvailable.jpg" alt="Land Image 2">
                <div class="container">
                    <h4><b>Teren la Breasta</b></h4>
                    <p>5 euro/metru</p>
                    <button onclick="addToCart('Teren in Brestei', 250)">Buy</button>
                </div>
            </div>
        </div>

        <button class="button-28" onclick="location.href='@Url.Action("Index", "Home")'">Back</button>
    </div>

    <script>
        function filterItems() {
            let input = document.getElementById("searchBar").value.toLowerCase();
            let listItems = document.querySelectorAll("#landList li");

            listItems.forEach(item => {
                let text = item.textContent.toLowerCase();
                item.style.display = text.includes(input) ? "block" : "none";
            });
        }
    </script>
</body>
</html>